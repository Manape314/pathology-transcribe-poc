# Copy this file to .env (gitignored) on the machine running
# print_agent.py — the Windows PC physically connected to the NIIMBOT
# B21 — or set these as real environment variables there. This is
# SEPARATE from backend/.env.example: the agent runs on a different
# machine than the hosted backend and never needs PostgreSQL credentials
# or anything else backend-side.

# Where the hosted (or local) backend lives.
BACKEND_URL=http://localhost:8000

# Must match the backend's PRINT_AGENT_TOKEN exactly. Without it, every
# request this agent makes is rejected with 401 (see main.py's
# require_agent_token — fails closed, not silently open).
AGENT_TOKEN=

# This station's identity. Only one station exists in this prototype;
# kept configurable so a second one doesn't need a protocol change later
# (see README's "Printer/station identity").
STATION_ID=POC_PRINTER_01

# How often to check for a new job when idle.
POLL_INTERVAL_SECONDS=5

# --- NIIMBOT hardware config (read by label_printing.py) ---
PRINTER_CONNECTION=usb
PRINTER_USB_PORT=auto
# PRINTER_BT_ADDRESS=
PRINTER_DENSITY=3
# PRINTER_LABEL_WIDTH_MM=50
# PRINTER_LABEL_HEIGHT_MM=30
