# Copy this file to .env (gitignored) and fill in real values, or set
# these as real environment variables on your host (e.g. Render's
# dashboard). Never commit actual credentials.

# PostgreSQL connection string for the shared request store
# (backend/print_records.py). If unset, falls back to a local SQLite file
# (backend/data/print_records.db) — fine for local development and the
# test suite, not for a deployment the pathologist reaches from another
# device. Render injects this automatically when you link a Render
# Postgres instance to this web service.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Comma-separated list of frontend origins allowed to call this API.
# Unset, this falls back to "*" — fine for local development, NOT for a
# real deployment (see main.py's CORS comment).
# ALLOWED_ORIGINS=https://my-frontend.onrender.com

# Where frontend/lookup.html is actually served from — used to build the
# QR code's lookup URL (backend/label_printing.py). Set this to wherever
# you deploy the frontend.
# FRONTEND_URL=https://my-frontend.onrender.com

# Shared secret the local print agent (backend/print_agent.py) must send
# as "Authorization: Bearer <this value>" on every print-job-queue
# request. REQUIRED for printing to work at all — unset, every
# agent-facing endpoint rejects everything (fails closed, never silently
# open). Generate a long random value, e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`.
# PRINT_AGENT_TOKEN=

# How long a job can sit "printing" (claimed but never completed/failed —
# an agent presumably crashed) before it's offered to another claim, and
# how many such claims a job tolerates before being auto-marked "failed"
# instead of retried forever. Sensible defaults, rarely need changing.
# STALE_JOB_TIMEOUT_SECONDS=120
# MAX_PRINT_ATTEMPTS=5

# --- Existing model config (unchanged by this migration) ---
# WHISPER_MODEL=large-v3
# DEVICE=cpu
# COMPUTE_TYPE=int8

# NOTE: PRINTER_CONNECTION / PRINTER_USB_PORT / PRINTER_BT_ADDRESS /
# PRINTER_DENSITY / PRINTER_LABEL_WIDTH_MM / PRINTER_LABEL_HEIGHT_MM are
# NOT backend config anymore — the hosted backend never talks to the
# printer. They belong on whichever machine runs print_agent.py instead;
# see print_agent_requirements.txt / README's "Local print agent" section.
